# Supabase Configuration
# These environment variables are automatically set when you connect Supabase integration in v0

# For local development with Vite (optional - use these if running locally)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# For Vercel deployment (automatically configured by v0 Supabase integration)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
